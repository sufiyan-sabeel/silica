sfn main() {
    assert(2 + 3 == 5)
    assert(10 - 4 == 6)
    assert(6 * 7 == 42)
    assert(7 / 2 == 3)
    assert(-7 / 2 == -3)
    assert(-7 % 2 == -1)
    assert(7 % 2 == 1)
    assert(1 + 2 * 3 == 7)
    assert((1 + 2) * 3 == 9)
    assert(2.5 * 2.0 == 5.0)
    assert(1 == 1.0)
    assert(non (1 == 2))
    assert(3 < 4)
    assert(4 <= 4)
    assert(5 > 4)
    assert(5 >= 6 == nein)
    assert(type_of(1) == "Int")
    assert(type_of(1.0) == "Float")
    assert(int("42") == 42)
    assert(float("2.5") == 2.5)
    assert(str(42) == "42")
    sprint("arithmetic ok")
}
